<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Deminvincibility</AssemblyName>
    <Description>Deminvincibility</Description>
    <Version>3.0.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!--
      Location of your SPT 5.0 install. Change the default here, or override it per build:
        dotnet build -p:SPTPath="D:\SPT 5.0"
    -->
    <SPTPath Condition="'$(SPTPath)' == ''">C:\sptarkov\SPTarkov 5.0.0-local</SPTPath>
    <BepInExCorePath>$(SPTPath)\BepInEx\core</BepInExCorePath>
    <InteropPath>$(SPTPath)\BepInEx\interop</InteropPath>
    <SptPluginsPath>$(SPTPath)\BepInEx\plugins\sptushonka</SptPluginsPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 (IL2CPP) plugin loader -->
    <Reference Include="0Harmony"><HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCorePath)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCorePath)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCorePath)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepInExCorePath)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- SPT 5.0 (SPTushonka) -->
    <Reference Include="SPTushonka.Reflection"><HintPath>$(SptPluginsPath)\SPTushonka.Reflection.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Interop assemblies generated by BepInEx from the IL2CPP game -->
    <Reference Include="Assembly-CSharp"><HintPath>$(InteropPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PlayerEnums"><HintPath>$(InteropPath)\PlayerEnums.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropPath)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppSystem"><HintPath>$(InteropPath)\Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(InteropPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(InteropPath)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Utilities"><HintPath>$(InteropPath)\Sirenix.Utilities.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy /y /f &quot;$(TargetPath)&quot; &quot;$(ProjectDir)Build\BepInEx\plugins\&quot;" />
  </Target>

</Project>